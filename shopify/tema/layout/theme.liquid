<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_acento }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.pagina' | t: numero: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}

    {% render 'variables-css' %}
    {{ 'tema.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'tema.js' | asset_url }}" defer="defer"></script>
    <script>
      window.tema = {
        rutas: {
          raiz: {{ routes.root_url | json }},
          carritoAgregar: {{ routes.cart_add_url | json }},
          carritoCambiar: {{ routes.cart_change_url | json }},
          recomendaciones: {{ routes.product_recommendations_url | json }}
        },
        entrega: {
          min: {{ settings.entrega_min | json }},
          max: {{ settings.entrega_max | json }},
          horaCorte: {{ settings.hora_corte | json }}
        },
        textos: {
          agregando: {{ 'producto.agregando' | t | json }},
          agregar: {{ 'producto.agregar' | t | json }},
          agotado: {{ 'producto.agotado' | t | json }},
          noDisponible: {{ 'producto.no_disponible' | t | json }},
          errorCarrito: {{ 'carrito.error' | t | json }},
          entregaRango: {{ 'producto.entrega_rango' | t | json }},
          entregaDia: {{ 'producto.entrega_dia' | t | json }}
        }
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="plantilla-{{ template.name | handle }}">
    <a class="saltar-contenido" href="#contenido">{{ 'general.saltar_contenido' | t }}</a>

    {% sections 'header-group' %}

    <main id="contenido" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'carrito-lateral' %}

    {%- if settings.whatsapp != blank -%}
      <a
        class="whatsapp-flotante"
        href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}?text={{ 'general.whatsapp_mensaje' | t: tienda: shop.name | url_encode }}"
        target="_blank"
        rel="noopener"
        aria-label="{{ 'general.whatsapp' | t }}"
      >
        {% render 'icono', nombre: 'whatsapp' %}
      </a>
    {%- endif -%}
  </body>
</html>
