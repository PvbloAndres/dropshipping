    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {% render 'meta-tags' %}
    {% render 'variables-css' %}
    {{ 'tema.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
