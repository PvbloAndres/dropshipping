<article class="seccion contenedor contenedor--angosto">
  <p class="seccion__etiqueta">{{ article.published_at | time_tag: format: 'date' }}</p>
  <h1 class="seccion__titulo">{{ article.title }}</h1>
  {%- if article.image -%}
    {{ article.image | image_url: width: 1200 | image_tag: loading: 'eager', class: 'articulo__imagen', widths: '600, 900, 1200' }}
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
</article>

{% schema %}
{ "name": "Artículo", "class": "seccion-articulo" }
{% endschema %}
