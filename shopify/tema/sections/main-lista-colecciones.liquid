<section class="seccion contenedor">
  <h1 class="seccion__titulo">{{ 'coleccion.todas' | t }}</h1>
  <div class="grilla-colecciones">
    {%- for coleccion in collections -%}
      <a class="tarjeta-coleccion" href="{{ coleccion.url }}">
        {%- if coleccion.featured_image -%}
          {{ coleccion.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 50vw' }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'marcador' }}
        {%- endif -%}
        <span>{{ coleccion.title }} {% render 'icono', nombre: 'flecha' %}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Lista de colecciones", "class": "seccion-lista-colecciones" }
{% endschema %}
