<footer class="pie">
  <div class="contenedor pie__grilla">
    <div class="pie__marca">
      <p class="pie__nombre">{{ shop.name }}</p>
      {%- if section.settings.texto != blank -%}
        <div class="pie__texto">{{ section.settings.texto }}</div>
      {%- endif -%}
      <ul class="pie__redes">
        {%- if settings.instagram != blank -%}
          <li><a href="https://instagram.com/{{ settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icono', nombre: 'instagram' %}</a></li>
        {%- endif -%}
        {%- if settings.tiktok != blank -%}
          <li><a href="https://www.tiktok.com/@{{ settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icono', nombre: 'tiktok' %}</a></li>
        {%- endif -%}
        {%- if settings.facebook != blank -%}
          <li><a href="{{ settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icono', nombre: 'facebook' %}</a></li>
        {%- endif -%}
      </ul>
    </div>

    {%- assign menu = linklists[section.settings.menu] -%}
    {%- if menu.links.size > 0 -%}
      <nav class="pie__menu" aria-label="{{ menu.title | escape }}">
        <p class="pie__titulo">{{ menu.title }}</p>
        <ul>
          {%- for link in menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if shop.policies.size > 0 -%}
      <nav class="pie__menu" aria-label="{{ 'general.politicas' | t }}">
        <p class="pie__titulo">{{ 'general.politicas' | t }}</p>
        <ul>
          {%- for politica in shop.policies -%}
            <li><a href="{{ politica.url }}">{{ politica.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>

  <div class="contenedor pie__final">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    {%- if section.settings.mostrar_pagos -%}
      <ul class="pie__pagos" aria-label="{{ 'general.medios_pago' | t }}">
        {%- for tipo in shop.enabled_payment_types -%}
          <li>{{ tipo | payment_type_svg_tag: class: 'icono-pago' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "class": "seccion-pie",
  "settings": [
    { "type": "richtext", "id": "texto", "label": "Texto", "default": "<p>Accesorios prácticos para perros y gatos, con envío a todo Chile.</p>" },
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" },
    { "type": "checkbox", "id": "mostrar_pagos", "label": "Mostrar íconos de medios de pago", "default": true }
  ]
}
{% endschema %}
